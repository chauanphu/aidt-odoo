<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- aidt.doc.chunk không mang department_id/secrecy_level của riêng nó — ACL
     một mình cho phép Chuyên viên (nhóm gốc) đọc toàn bộ bảng, kể cả các
     đoạn thuộc văn bản mật ngoài đơn vị. Ba rule dưới đây bắt chunk kế thừa
     đúng phạm vi + độ mật của aidt.document cha qua document_id, cùng công
     thức với rule_aidt_document_scope/_secrecy/_admin của aidt_org. Deliberately
     NOT noupdate="1", cùng lý do với aidt_org_rules.xml: rule bảo mật phải
     luôn nhận domain_force mới nhất khi nâng cấp module. -->
<data>

    <record id="rule_aidt_doc_chunk_scope" model="ir.rule">
        <field name="name">Đoạn nội dung: theo phạm vi văn bản gốc</field>
        <field name="model_id" ref="model_aidt_doc_chunk"/>
        <field name="groups" eval="[(4, ref('aidt_org.group_chuyen_vien'))]"/>
        <field name="domain_force">['|', ('document_id.department_id', '=', False), '|', ('document_id.department_id', 'child_of', user.employee_id.department_id.ids), ('document_id.shared_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_aidt_doc_chunk_secrecy" model="ir.rule">
        <field name="name">Đoạn nội dung: chặn theo độ mật văn bản gốc (toàn cục)</field>
        <field name="model_id" ref="model_aidt_doc_chunk"/>
        <field name="domain_force">[('document_id.secrecy_level', '&lt;=', user.clearance_level)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_aidt_doc_chunk_admin" model="ir.rule">
        <field name="name">Đoạn nội dung: quản trị toàn quyền</field>
        <field name="model_id" ref="model_aidt_doc_chunk"/>
        <field name="groups" eval="[(4, ref('aidt_org.group_aidt_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

<!-- aidt.index.job có cùng vấn đề như aidt.doc.chunk ở trên: bản thân nó
     không mang department_id/secrecy_level riêng, ACL Task 13 cho Chuyên
     viên (nhóm gốc) perm_read=1 trên toàn bảng — không có ba rule dưới đây
     thì bất kỳ Chuyên viên nào cũng thấy được sự tồn tại, document_id,
     trạng thái xử lý và thông điệp lỗi (field `error`, có thể lộ tên
     tệp/nội dung trích từ ngoại lệ) của MỌI job, kể cả job của văn bản mật
     ngoài đơn vị — dù aidt.document cha đã bị chặn đúng. Cùng công thức với
     rule_aidt_doc_chunk_*/rule_aidt_document_* của aidt_org, chỉ đổi
     model_id và giữ nguyên đường dẫn document_id.*. Deliberately NOT
     noupdate="1", cùng lý do với phần rule doc_chunk ở trên. -->

    <record id="rule_aidt_index_job_scope" model="ir.rule">
        <field name="name">Việc chỉ mục: theo phạm vi văn bản gốc</field>
        <field name="model_id" ref="model_aidt_index_job"/>
        <field name="groups" eval="[(4, ref('aidt_org.group_chuyen_vien'))]"/>
        <field name="domain_force">['|', ('document_id.department_id', '=', False), '|', ('document_id.department_id', 'child_of', user.employee_id.department_id.ids), ('document_id.shared_user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_aidt_index_job_secrecy" model="ir.rule">
        <field name="name">Việc chỉ mục: chặn theo độ mật văn bản gốc (toàn cục)</field>
        <field name="model_id" ref="model_aidt_index_job"/>
        <field name="domain_force">[('document_id.secrecy_level', '&lt;=', user.clearance_level)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_aidt_index_job_admin" model="ir.rule">
        <field name="name">Việc chỉ mục: quản trị toàn quyền</field>
        <field name="model_id" ref="model_aidt_index_job"/>
        <field name="groups" eval="[(4, ref('aidt_org.group_aidt_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

<!-- aidt.search.log ghi lại NGƯỜI DÙNG ĐÃ TÌM GÌ — nhạy cảm đúng nghĩa N-08
     (nhật ký truy cập tài liệu mật). Không có hai rule dưới đây, ACL
     perm_read=1 cho Chuyên viên (nhóm gốc) đủ để bất kỳ ai trong nhóm đó đọc
     TRUY VẤN GỐC của MỌI đồng nghiệp — kể cả câu truy vấn động chạm nội
     dung văn bản mật mà chính người đọc log không có quyền xem — tức là một
     đường dò vòng qua ir.rule của aidt.document mà không cần đọc
     aidt.document. Cùng bài học "mỗi model một rule riêng, không cascade"
     như hai khối rule ở trên, nhưng đổi trục phạm vi: log không mang
     department_id/secrecy_level riêng để soi theo đơn vị/độ mật, trục duy
     nhất có ý nghĩa ở đây là "của chính mình hay không". Deliberately NOT
     noupdate="1", cùng lý do với hai khối rule ở trên. -->

    <record id="rule_aidt_search_log_own" model="ir.rule">
        <field name="name">Nhật ký tìm kiếm: chỉ xem của chính mình</field>
        <field name="model_id" ref="model_aidt_search_log"/>
        <field name="groups" eval="[(4, ref('aidt_org.group_chuyen_vien'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_aidt_search_log_admin" model="ir.rule">
        <field name="name">Nhật ký tìm kiếm: quản trị toàn quyền (kiểm toán N-08)</field>
        <field name="model_id" ref="model_aidt_search_log"/>
        <field name="groups" eval="[(4, ref('aidt_org.group_aidt_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</data>
</odoo>
