<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- `aidt_vanban_den.view_aidt_document_form` (brief) không tồn tại. Form
         cơ sở thật là `aidt_org.aidt_document_view_form` — nhưng menu "Văn
         bản đến" đang hoạt động (action_vanban_den) lại gắn thẳng
         `aidt_vanban_den.aidt_vanban_den_view_form`, một form ĐỘC LẬP không
         kế thừa form cơ sở này. Chỉ sửa form cơ sở thì badge sẽ không bao
         giờ hiện trên màn hình người dùng thật sự dùng — nên kế thừa CẢ HAI. -->

    <record id="aidt_document_view_form_search" model="ir.ui.view">
        <field name="name">aidt.document.form.search</field>
        <field name="model">aidt.document</field>
        <field name="inherit_id" ref="aidt_org.aidt_document_view_form"/>
        <field name="arch" type="xml">
            <!-- Round-1 review: `sheet position="inside"` từng thêm một
                 `<div class="oe_button_box">` MỚI, rơi xuống cuối form dưới
                 mọi group/tab thay vì nằm cùng cụm nút thống kê trên đầu.
                 Form này đã có sẵn đúng một `<div name="button_box"/>` rỗng
                 (aidt_org/views/aidt_document_views.xml) dành riêng cho việc
                 này — nhắm thẳng vào đó. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_reindex"
                        class="oe_stat_button" icon="fa-refresh"
                        help="Nạp lại toàn bộ tệp của văn bản vào chỉ mục tìm kiếm">
                    <field name="chunk_count" widget="statinfo" string="Đoạn đã chỉ mục"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='group_left']" position="inside">
                <field name="index_state" widget="badge"
                       decoration-success="index_state == 'indexed'"
                       decoration-info="index_state == 'pending'"
                       decoration-danger="index_state == 'failed'"
                       decoration-muted="index_state == 'none'"/>
            </xpath>
        </field>
    </record>

    <record id="aidt_vanban_den_view_form_search" model="ir.ui.view">
        <field name="name">aidt.document.form.vanban.den.search</field>
        <field name="model">aidt.document</field>
        <field name="inherit_id" ref="aidt_vanban_den.aidt_vanban_den_view_form"/>
        <field name="arch" type="xml">
            <!-- Form này đã có `<div name="button_box">` chứa sẵn hai nút
                 thống kê (Nhiệm vụ, Tệp đính kèm) — nhắm vào đúng box đó,
                 không tạo box thứ hai rơi xuống cuối form. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_reindex"
                        class="oe_stat_button" icon="fa-refresh"
                        help="Nạp lại toàn bộ tệp của văn bản vào chỉ mục tìm kiếm">
                    <field name="chunk_count" widget="statinfo" string="Đoạn đã chỉ mục"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='group_left']" position="inside">
                <field name="index_state" widget="badge"
                       decoration-success="index_state == 'indexed'"
                       decoration-info="index_state == 'pending'"
                       decoration-danger="index_state == 'failed'"
                       decoration-muted="index_state == 'none'"/>
            </xpath>
        </field>
    </record>
</odoo>
