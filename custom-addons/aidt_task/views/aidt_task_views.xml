<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="aidt_task_view_list" model="ir.ui.view">
        <field name="name">aidt.task.list</field>
        <field name="model">aidt.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="document_id" optional="show"/>
                <field name="department_id"/>
                <field name="assignee_id"/>
                <field name="deadline"/>
                <field name="is_overdue" optional="hide"/>
                <field name="secrecy"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'pending_review'"/>
            </list>
        </field>
    </record>

    <record id="aidt_task_view_form" model="ir.ui.view">
        <field name="name">aidt.task.form</field>
        <field name="model">aidt.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Gửi yêu cầu" type="object"
                            class="oe_highlight"
                            groups="aidt_org.group_chuyen_vien,aidt_org.group_truong_phong,aidt_org.group_aidt_admin"
                            invisible="state != 'new'"/>
                    <button name="action_submit_review" string="Nộp báo cáo kết quả"
                            type="object" class="oe_highlight"
                            groups="aidt_org.group_chuyen_vien,aidt_org.group_truong_phong,aidt_org.group_aidt_admin"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve" string="Duyệt đóng"
                            type="object" class="oe_highlight"
                            groups="aidt_org.group_truong_phong,aidt_org.group_chanh_vp,aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_aidt_admin"
                            invisible="state != 'pending_review'"/>
                    <button name="action_reject" string="Trả lại" type="object"
                            groups="aidt_org.group_truong_phong,aidt_org.group_chanh_vp,aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_aidt_admin"
                            invisible="state != 'pending_review'"/>
                    <button name="action_hold" string="Tạm dừng" type="object"
                            groups="aidt_org.group_truong_phong,aidt_org.group_chanh_vp,aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_aidt_admin"
                            invisible="state in ('done', 'on_hold')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,pending_review,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Quá hạn"
                            bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nội dung nhiệm vụ" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/></h1>
                    </div>
                    <group>
                        <group string="Nguồn">
                            <field name="document_id" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="source_quote" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="source_ref" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                        </group>
                        <group string="Phân công">
                            <field name="department_id" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="collaborator_department_ids"
                                   widget="many2many_tags" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="assignee_id" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="assigner_id" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                        </group>
                        <group string="Thời hạn &amp; Độ mật">
                            <field name="deadline" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="deadline_note" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                            <field name="secrecy" readonly="state in ['in_progress', 'pending_review', 'done', 'on_hold']"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Báo cáo kết quả">
                            <field name="result_ids" readonly="state in ['new', 'pending_review', 'done', 'on_hold']">
                                <list editable="bottom">
                                    <field name="submit_date"/>
                                    <field name="submit_uid"/>
                                    <field name="report"/>
                                    <field name="attachment_ids"
                                           widget="many2many_binary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="aidt_task_view_kanban" model="ir.ui.view">
        <field name="name">aidt.task.kanban</field>
        <field name="model">aidt.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="is_overdue"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column h-100" style="border-radius: 16px; border: 1px solid #E2E8F0; background: #FFFFFF; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04); padding: 12px 16px;">
                            <!-- Header with Roundel -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="fw-bold pe-3" style="font-size: 1.05rem; color: #0F172A; line-height: 1.4;">
                                    <field name="name"/>
                                </div>
                                <div t-if="record.is_overdue.raw_value" class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #FFF1F2; color: #F43F5E; border-radius: 12px;">
                                    <i class="fa fa-exclamation-triangle fs-5"></i>
                                </div>
                                <div t-elif="record.state.raw_value == 'done'" class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #ECFDF5; color: #10B981; border-radius: 12px;">
                                    <i class="fa fa-check fs-5"></i>
                                </div>
                                <div t-elif="record.state.raw_value == 'pending_review'" class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #FFFBEB; color: #F59E0B; border-radius: 12px;">
                                    <i class="fa fa-eye fs-5"></i>
                                </div>
                                <div t-else="" class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #E6F0F7; color: #005B9A; border-radius: 12px;">
                                    <i class="fa fa-tasks fs-5"></i>
                                </div>
                            </div>
                            
                            <!-- Content Details -->
                            <div class="d-flex flex-column gap-2 mb-4" style="color: #475569; font-size: 0.9rem;">
                                <div class="d-flex align-items-start">
                                    <i class="fa fa-building-o fa-fw mt-1 me-2" style="color: #94A3B8;"/>
                                    <span class="lh-sm"><field name="department_id"/></span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-calendar fa-fw me-2" style="color: #94A3B8;"/>
                                    <span t-attf-class="{{ record.is_overdue.raw_value ? 'fw-bold text-danger' : 'fw-bold' }}" style="font-family: 'JetBrains Mono', monospace; color: #334155;">
                                        <field name="deadline"/>
                                    </span>
                                </div>
                            </div>

                            <!-- Footer -->
                            <footer class="mt-auto d-flex align-items-center justify-content-between pt-3" style="border-top: 1px dashed #E2E8F0;">
                                <div class="d-flex align-items-center gap-2">
                                    <field name="assignee_id" widget="many2one_avatar_user"/>
                                    <div class="fw-bold text-truncate" style="color: #64748B; font-size: 0.85rem; max-width: 120px;"><field name="assignee_id"/></div>
                                </div>
                                <span t-if="record.is_overdue.raw_value" class="badge" style="background: #FFF1F2; color: #E11D48; border: 1px solid #FECDD3; border-radius: 20px; padding: 5px 12px; font-weight: 700; letter-spacing: 0.02em;">QUÁ HẠN</span>
                                <span t-elif="record.state.raw_value == 'done'" class="badge" style="background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; border-radius: 20px; padding: 5px 12px; font-weight: 700; letter-spacing: 0.02em;">HOÀN THÀNH</span>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="aidt_task_view_search" model="ir.ui.view">
        <field name="name">aidt.task.search</field>
        <field name="model">aidt.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_id"/>
                <field name="department_id"/>
                <field name="assignee_id"/>
                <filter name="overdue" string="Quá hạn"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="pending" string="Chờ duyệt"
                        domain="[('state', '=', 'pending_review')]"/>
                <filter name="mine" string="Của tôi"
                        domain="[('assignee_id', '=', uid)]"/>
                <separator/>
                <filter name="not_done" string="Chưa hoàn thành"
                        domain="[('state', '!=', 'done')]"/>
                <separator/>
                <filter name="gb_dept" string="Đơn vị"
                        context="{'group_by': 'department_id'}"/>
                <filter name="gb_state" string="Trạng thái"
                        context="{'group_by': 'state'}"/>
                <filter name="gb_secrecy" string="Độ mật"
                        context="{'group_by': 'secrecy'}"/>
                <filter name="gb_assignee" string="Người thực hiện"
                        context="{'group_by': 'assignee_id'}"/>
            </search>
        </field>
    </record>

    <record id="aidt_task_action" model="ir.actions.act_window">
        <field name="name">Nhiệm vụ</field>
        <field name="res_model">aidt.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="aidt_task_view_search"/>
    </record>

    <menuitem id="menu_aidt_task_root" name="Nhiệm vụ" sequence="2"/>
    <menuitem id="menu_aidt_task" name="Danh mục nhiệm vụ"
              parent="menu_aidt_task_root" action="aidt_task_action"
              sequence="10"/>

</odoo>
