<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for AI OCR Wizard with 2-Step Preview & Manual Confirmation -->
    <record id="view_aidt_document_ocr_wizard_form" model="ir.ui.view">
        <field name="name">aidt.document.ocr.wizard.form</field>
        <field name="model">aidt.document.ocr.wizard</field>
        <field name="arch" type="xml">
            <form string="Trích xuất AI (OCR) từ Tệp / Scan Giấy">
                <field name="state" invisible="1"/>
                <sheet>
                    <div class="alert alert-info text-center" role="alert" invisible="state == 'preview'">
                        <strong>BƯỚC 1: TẢI TỆP CÔNG VĂN &amp; PHÂN TÍCH AI OCR</strong>
                        <br/>
                        <span>Tải tệp PDF hoặc ảnh scan. Bấm <strong>"Phân tích AI OCR (Xem trước)"</strong> để bóc tách thông tin.</span>
                    </div>
                    <div class="alert alert-success text-center" role="alert" invisible="state != 'preview'">
                        <strong>BƯỚC 2: XÁC NHẬN KẾT QUẢ BÓC TÁCH AI OCR (PREVIEW)</strong>
                        <br/>
                        <span>Kiểm tra và tùy chỉnh thông tin bóc tách dưới đây. Bấm <strong>"Xác nhận &amp; Điền vào Form"</strong> để chuyển dữ liệu vào Form. Dữ liệu sẽ chưa tự động lưu, bạn cần bấm <strong>"Lưu"</strong> trên Form.</span>
                    </div>

                    <group invisible="state == 'preview'">
                        <group string="1. Chọn tệp scan/ảnh văn bản">
                            <field name="file_scan" filename="file_scan_name" widget="binary" string="Tệp scan / Ảnh công văn"/>
                            <field name="file_scan_name" invisible="1"/>
                            <field name="ai_engine" widget="radio"/>
                            <field name="direction" invisible="1"/>
                            <field name="document_id" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info d-flex align-items-center justify-content-between p-2 mb-3" role="alert" invisible="state != 'preview'">
                        <span>Các thông tin dưới đây đã được <strong>Gemma 4 AI bóc tách &amp; suy luận tự động</strong>. Bạn có thể kiểm tra hoặc điều chỉnh lại trước khi xác nhận.</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" style="white-space: nowrap;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -1px;" class="me-1">
                                <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                            </svg>
                            Gợi ý AI
                        </span>
                    </div>

                    <group string="BẢNG XÁC NHẬN &amp; XEM TRƯỚC KẾT QUẢ BÓC TÁCH AI (PREVIEW)" invisible="state != 'preview'">
                        <group name="preview_left">
                            <label for="extracted_name" string="Trích yếu" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-start mb-3">
                                <span class="text-success me-2 mt-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_name or extracted_name == 'Không có'">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_name" widget="text" nolabel="1" class="w-100" style="min-height: 60px; white-space: normal; word-break: break-word;"/>
                            </div>

                            <label for="extracted_reference" string="Số / Ký hiệu" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_reference or extracted_reference == 'Không có'">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_reference" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_doc_type" string="Loại văn bản" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_doc_type">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_doc_type" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_secrecy" string="Độ mật" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_secrecy">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_secrecy" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_do_khan" string="Độ khẩn" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_do_khan">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_do_khan" nolabel="1" class="w-100"/>
                            </div>
                        </group>
                        <group name="preview_right">
                            <label for="extracted_so_den" string="Số đến" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_so_den or extracted_so_den == 'Không có'">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_so_den" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_ngay_den" string="Ngày đến" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_ngay_den">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_ngay_den" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_issuer" string="Cơ quan gửi" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-start mb-3">
                                <span class="text-success me-2 mt-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_issuer or extracted_issuer == 'Không có'">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_issuer" widget="text" nolabel="1" class="w-100" style="min-height: 48px; white-space: normal; word-break: break-word;"/>
                            </div>

                            <label for="extracted_date" string="Ngày ban hành gốc" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_date">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_date" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_so_ban" string="Số bản" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_so_ban or extracted_so_ban == 0">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_so_ban" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_department_id" string="Đơn vị phân công" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_department_id">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_department_id" options="{'no_create': True, 'no_open': True}" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_date_received" string="Ngày tiếp nhận" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_date_received">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_date_received" nolabel="1" class="w-100"/>
                            </div>

                            <label for="extracted_shared_user_ids" string="Chia sẻ với" class="fw-bold mb-1"/>
                            <div class="d-flex align-items-center mb-3">
                                <span class="text-success me-2 flex-shrink-0" title="Gợi ý AI" invisible="not extracted_shared_user_ids">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                    </svg>
                                </span>
                                <field name="extracted_shared_user_ids" widget="many2many_tags" nolabel="1" class="w-100"/>
                            </div>
                        </group>
                    </group>

                    <group string="TRÍCH DẪN &amp; BẰNG CHỨNG AI SUY LUẬN (CHAIN-OF-THOUGHT)" invisible="state != 'preview'">
                        <div class="d-flex align-items-center mb-2" invisible="not extracted_reasoning">
                            <span class="badge bg-success text-white px-2 py-1 rounded-pill me-2" style="white-space: nowrap;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -1px;" class="me-1">
                                    <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
                                </svg>
                                Bằng chứng AI
                            </span>
                            <span class="text-muted small">Căn cứ trích dẫn bằng chứng nguyên văn và các bước suy luận của mô hình AI:</span>
                        </div>
                        <field name="extracted_reasoning" widget="text" readonly="1" nolabel="1" class="font-monospace p-2 border rounded"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run_ai_ocr" string="Phân tích AI OCR (Xem trước)" type="object" class="btn-primary" invisible="state == 'preview'"/>
                    <button name="action_confirm_and_fill" string="Xác nhận &amp; Điền vào Form (Cần bấm Lưu)" type="object" class="btn-success" invisible="state != 'preview'"/>
                    <button name="action_reset_preview" string="Chọn lại tệp" type="object" class="btn-secondary" invisible="state != 'preview'"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open AI OCR Wizard with extra-large dialog width -->
    <record id="action_aidt_document_ocr_wizard" model="ir.actions.act_window">
        <field name="name">Trích xuất AI (OCR) từ Tệp / Scan Giấy</field>
        <field name="res_model">aidt.document.ocr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
