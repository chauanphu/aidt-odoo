<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for AI OCR Wizard with 2-Step Preview & Manual Confirmation -->
    <record id="view_aidt_document_ocr_wizard_form" model="ir.ui.view">
        <field name="name">aidt.document.ocr.wizard.form</field>
        <field name="model">aidt.document.ocr.wizard</field>
        <field name="arch" type="xml">
            <form string="Trích xuất AI (OCR) từ Tệp / Scan Giấy">
                <field name="state" invisible="1"/>
                <sheet>
                    <div class="alert alert-info text-center" role="alert" invisible="state == 'preview'">
                        <strong>BƯỚC 1: TẢI TỆP CÔNG VĂN &amp; PHÂN TÍCH AI OCR</strong>
                        <br/>
                        <span>Tải tệp PDF hoặc ảnh scan. Bấm <strong>"Phân tích AI OCR (Xem trước)"</strong> để bóc tách thông tin.</span>
                    </div>
                    <div class="alert alert-success text-center" role="alert" invisible="state != 'preview'">
                        <strong>BƯỚC 2: XÁC NHẬN KẾT QUẢ BÓC TÁCH AI OCR (PREVIEW)</strong>
                        <br/>
                        <span>Kiểm tra và tùy chỉnh thông tin bóc tách dưới đây. Bấm <strong>"Xác nhận &amp; Điền vào Form"</strong> để chuyển dữ liệu vào Form. Dữ liệu sẽ chưa tự động lưu, bạn cần bấm <strong>"Lưu"</strong> trên Form.</span>
                    </div>

                    <group invisible="state == 'preview'">
                        <group string="1. Chọn tệp scan/ảnh văn bản">
                            <field name="file_scan" filename="file_scan_name" widget="binary" string="Tệp scan / Ảnh công văn"/>
                            <field name="file_scan_name" invisible="1"/>
                            <field name="ai_engine" widget="radio"/>
                            <field name="direction" invisible="1"/>
                            <field name="document_id" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info d-flex align-items-center justify-content-between p-2 mb-3" role="alert" invisible="state != 'preview'">
                        <span><i class="fa fa-magic text-primary me-2"/> Các thông tin dưới đây đã được <strong>Gemma 4 AI bóc tách &amp; suy luận tự động</strong>. Bạn có thể kiểm tra hoặc điều chỉnh lại trước khi xác nhận.</span>
                        <span class="badge bg-warning text-dark px-2 py-1 rounded-pill"><i class="fa fa-robot me-1"/> Gợi ý AI</span>
                    </div>

                    <group string="BẢNG XÁC NHẬN &amp; XEM TRƯỚC KẾT QUẢ BÓC TÁCH AI (PREVIEW)" invisible="state != 'preview'">
                        <group name="preview_left">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_name" string="Trích yếu" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_name or extracted_name == 'Không có'">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_name" widget="text" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_reference" string="Số / Ký hiệu" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_reference or extracted_reference == 'Không có'">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_reference" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_doc_type" string="Loại văn bản" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_doc_type">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_doc_type" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_secrecy" string="Độ mật" class="fw-bold mb-0"/>
                                <span class="badge bg-danger text-white px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_secrecy">
                                    <i class="fa fa-lock me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_secrecy" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_do_khan" string="Độ khẩn" class="fw-bold mb-0"/>
                                <span class="badge bg-danger text-white px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_do_khan">
                                    <i class="fa fa-bolt me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_do_khan" nolabel="1" class="w-100 mb-3"/>
                        </group>
                        <group name="preview_right">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_so_den" string="Số đến" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_so_den or extracted_so_den == 'Không có'">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_so_den" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_ngay_den" string="Ngày đến" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_ngay_den">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_ngay_den" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_issuer" string="Cơ quan gửi" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_issuer or extracted_issuer == 'Không có'">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_issuer" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_date" string="Ngày ban hành gốc" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_date">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_date" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_so_ban" string="Số bản" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_so_ban or extracted_so_ban == 0">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_so_ban" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_department_id" string="Đơn vị phân công" class="fw-bold mb-0"/>
                                <span class="badge bg-success text-white px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_department_id">
                                    <i class="fa fa-sitemap me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_department_id" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_date_received" string="Ngày tiếp nhận" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_date_received">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_date_received" nolabel="1" class="w-100 mb-3"/>

                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label for="extracted_shared_user_ids" string="Chia sẻ với" class="fw-bold mb-0"/>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="white-space: nowrap; flex-shrink: 0;" invisible="not extracted_shared_user_ids">
                                    <i class="fa fa-sparkles me-1"/>Gợi ý AI
                                </span>
                            </div>
                            <field name="extracted_shared_user_ids" widget="many2many_tags" nolabel="1" class="w-100 mb-3"/>
                        </group>
                    </group>

                    <group string="🧠 TRÍCH DẪN &amp; NHẬT KÝ AI GEMMA 4 SUY LUẬN (CHAIN-OF-THOUGHT)" invisible="state != 'preview'">
                        <div class="d-flex align-items-center mb-2" invisible="not extracted_reasoning">
                            <span class="badge bg-info text-white px-2 py-1 rounded-pill me-2" style="white-space: nowrap;"><i class="fa fa-quote-left me-1"/>Trích dẫn AI</span>
                            <span class="text-muted small">Bằng chứng trích dẫn nguyên văn và 5 bước suy luận tự động của mô hình AI:</span>
                        </div>
                        <field name="extracted_reasoning" widget="text" readonly="1" nolabel="1" class="font-monospace p-2 border rounded"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run_ai_ocr" string="Phân tích AI OCR (Xem trước)" type="object" class="btn-primary" icon="fa-search" invisible="state == 'preview'"/>
                    <button name="action_confirm_and_fill" string="Xác nhận &amp; Điền vào Form (Cần bấm Lưu)" type="object" class="btn-success" icon="fa-check-circle" invisible="state != 'preview'"/>
                    <button name="action_reset_preview" string="Chọn lại tệp" type="object" class="btn-secondary" icon="fa-undo" invisible="state != 'preview'"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open AI OCR Wizard -->
    <record id="action_aidt_document_ocr_wizard" model="ir.actions.act_window">
        <field name="name">Trích xuất AI (OCR) từ Tệp / Scan Giấy</field>
        <field name="res_model">aidt.document.ocr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
