<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aidt_document_form_dms" model="ir.ui.view">
        <field name="name">aidt.document.form.dms</field>
        <field name="model">aidt.document</field>
        <field name="inherit_id" ref="aidt_org.aidt_document_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="%(action_aidt_document_ocr_wizard)d" string="Trích xuất AI (OCR)" type="action"
                        class="btn-info" icon="fa-magic"
                        help="Tải tệp/ảnh scan để AI tự động trích xuất thông tin công văn giấy"/>
            </xpath>
            <sheet position="inside">
                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_open_files"
                            class="oe_stat_button" icon="fa-folder-open">
                        <field name="file_count" widget="statinfo" string="Tệp đính kèm"/>
                    </button>
                </div>
                <notebook>
                    <page string="Tệp đính kèm" name="files">
                        <group string="Tải tệp đính kèm mới (Kênh 1 &amp; 2)">
                            <group>
                                <field name="upload_file" filename="upload_filename" string="Chọn tệp đính kèm"/>
                                <field name="upload_filename" invisible="1"/>
                            </group>
                            <group>
                                <button name="action_save_upload_file" string="Lưu tệp đính kèm" type="object" class="btn-primary" icon="fa-upload" invisible="not upload_file"/>
                            </group>
                        </group>
                        <separator string="Danh sách tệp đính kèm đã lưu"/>
                        <field name="file_ids" readonly="1">
                            <list>
                                <field name="name" string="Tên tệp"/>
                                <field name="mimetype" string="Định dạng"/>
                                <field name="human_size" string="Dung lượng"/>
                                <field name="create_date" string="Ngày tải lên"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>
</odoo>
