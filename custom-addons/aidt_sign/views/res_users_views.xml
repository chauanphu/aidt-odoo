<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View dành cho Admin quản lý User trong Cài đặt -->
    <record id="view_users_form_inherit_aidt_sign" model="ir.ui.view">
        <field name="name">res.users.form.inherit.aidt.sign</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="Chữ ký số &amp; Chứng thư" name="digital_signature" groups="aidt_org.group_aidt_admin">
                    <div class="row mt-2">
                        <div class="col-12 col-md-4 border-end pe-md-3">
                            <group string="Ảnh chữ ký tay cá nhân">
                                <field name="digital_signature_img" nolabel="1" widget="image" options="{'size': [160, 80]}"/>
                            </group>
                        </div>
                        <div class="col-12 col-md-8 ps-md-3">
                            <group string="Danh sách Chứng thư số">
                                <field name="certificate_ids" nolabel="1" colspan="2" class="w-100 o_full_width" context="{'default_owner_id': id}">
                                    <list>
                                        <field name="name"/>
                                        <field name="cert_type"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- View kế thừa base.view_users_form_simple_modif cho My Preferences với Phân quyền 3 mức -->
    <record id="view_users_form_simple_inherit_aidt_sign" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.aidt.sign</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='preferences_page']" position="after">
                <!-- Mức 1: Tab Menu chỉ hiển thị cho Lãnh đạo, Văn thư & Admin. Nơi Chuyên viên bị ẩn toàn bộ -->
                <page string="Chữ ký số &amp; Chứng thư"
                      name="digital_signature_tab"
                      groups="aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_chanh_vp,aidt_org.group_truong_phong,aidt_org.group_van_thu,aidt_org.group_aidt_admin">
                    <div class="row mt-2">
                        <!-- Mức 2: Cột Trái (Ảnh chữ ký tay tươi) - Chỉ hiển thị cho Lãnh đạo & Admin (Văn thư bị ẩn) -->
                        <div class="col-12 col-md-4 border-end pe-md-3"
                             groups="aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_chanh_vp,aidt_org.group_truong_phong,aidt_org.group_aidt_admin">
                            <group string="1. Ảnh chữ ký tay tươi">
                                <field name="digital_signature_img" nolabel="1" widget="image" options="{'size': [140, 70]}"/>
                            </group>
                            <p class="text-muted small mt-1">Ảnh chữ ký tay tươi (.png) dùng để chèn vào vị trí người ký trên văn bản PDF.</p>
                        </div>
                        <!-- Mức 3: Cột Phải (Danh sách Chứng thư số .p12) - Hiển thị cho Lãnh đạo, Văn thư & Admin -->
                        <div class="col-12 col-md-8 ps-md-3"
                             groups="aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_chanh_vp,aidt_org.group_truong_phong,aidt_org.group_van_thu,aidt_org.group_aidt_admin">
                            <group string="2. Danh sách Chứng thư số (.p12)">
                                <field name="certificate_ids" nolabel="1" colspan="2" class="w-100 o_full_width" context="{'default_owner_id': id}" domain="[('owner_id', '=', id)]">
                                    <list string="Chứng thư số">
                                        <field name="name"/>
                                        <field name="cert_type"/>
                                        <field name="cert_filename" string="Tệp .p12"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
