<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View dành cho Admin quản lý User trong Cài đặt -->
    <record id="view_users_form_inherit_aidt_sign" model="ir.ui.view">
        <field name="name">res.users.form.inherit.aidt.sign</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="Chữ ký số &amp; Chứng thư" name="digital_signature">
                    <div class="row mt-2">
                        <div class="col-12 col-md-4 border-end pe-md-3">
                            <group string="Ảnh chữ ký tay cá nhân">
                                <field name="digital_signature_img" nolabel="1" widget="image" options="{'size': [160, 80]}"/>
                            </group>
                        </div>
                        <div class="col-12 col-md-8 ps-md-3">
                            <group string="Danh sách Chứng thư số">
                                <field name="certificate_ids" nolabel="1" colspan="2" class="w-100 o_full_width" context="{'default_owner_id': id}">
                                    <list>
                                        <field name="name"/>
                                        <field name="cert_type"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- View dành riêng cho Lãnh đạo tự quản lý Chữ ký tay tươi & Chứng thư số cá nhân của mình trong My Preferences -->
    <record id="view_users_form_simple_inherit_aidt_sign" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.aidt.sign</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Chữ ký số cá nhân (PAdES)" name="digital_signature_tab">
                    <div class="row mt-2">
                        <div class="col-12 col-md-4 border-end pe-md-3">
                            <group string="1. Ảnh chữ ký tay tươi">
                                <field name="digital_signature_img" nolabel="1" widget="image" options="{'size': [140, 70]}"/>
                            </group>
                            <p class="text-muted small mt-1">Ảnh chữ ký tay tươi (.png) dùng để chèn vào vị trí người ký trên văn bản PDF.</p>
                        </div>
                        <div class="col-12 col-md-8 ps-md-3">
                            <group string="2. Chứng thư số cá nhân của bạn (.p12)">
                                <field name="certificate_ids" nolabel="1" colspan="2" class="w-100 o_full_width" context="{'default_owner_id': id, 'default_cert_type': 'personal'}" domain="[('owner_id', '=', id)]">
                                    <list string="Chứng thư cá nhân">
                                        <field name="name"/>
                                        <field name="cert_filename" string="Tệp .p12"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </group>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
