<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aidt_sign_certificate_tree" model="ir.ui.view">
        <field name="name">aidt.sign.certificate.tree</field>
        <field name="model">aidt.sign.certificate</field>
        <field name="arch" type="xml">
            <tree string="Chứng thư số">
                <field name="name"/>
                <field name="cert_type"/>
                <field name="owner_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_aidt_sign_certificate_form" model="ir.ui.view">
        <field name="name">aidt.sign.certificate.form</field>
        <field name="model">aidt.sign.certificate</field>
        <field name="arch" type="xml">
            <form string="Chứng thư số PKCS#12">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cert_type"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="cert_file" filename="cert_filename"/>
                            <field name="cert_filename" invisible="1"/>
                            <field name="password" password="True"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aidt_sign_certificate" model="ir.actions.act_window">
        <field name="name">Quản lý Chứng thư số</field>
        <field name="res_model">aidt.sign.certificate</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_aidt_sign_root" name="Ký số PAdES" parent="aidt_base.menu_aidt_root" sequence="30"/>
    <menuitem id="menu_aidt_sign_certificate" name="Chứng thư số" parent="menu_aidt_sign_root" action="action_aidt_sign_certificate" sequence="10"/>
</odoo>
