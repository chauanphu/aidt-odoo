<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aidt_sign_certificate_list" model="ir.ui.view">
        <field name="name">aidt.sign.certificate.list</field>
        <field name="model">aidt.sign.certificate</field>
        <field name="arch" type="xml">
            <list string="Chứng thư số">
                <field name="name"/>
                <field name="cert_type"/>
                <field name="owner_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_aidt_sign_certificate_form" model="ir.ui.view">
        <field name="name">aidt.sign.certificate.form</field>
        <field name="model">aidt.sign.certificate</field>
        <field name="arch" type="xml">
            <form string="Chứng thư số PKCS#12">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cert_type"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="cert_file" filename="cert_filename"/>
                            <field name="cert_filename" invisible="1"/>
                            <field name="password" password="True"/>
                            <field name="seal_img" string="Ảnh con dấu đỏ Cơ quan (PNG)" widget="image" options="{'size': [180, 90]}" invisible="cert_type != 'org'"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aidt_sign_certificate" model="ir.actions.act_window">
        <field name="name">Quản lý Chứng thư số</field>
        <field name="res_model">aidt.sign.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Ký số PAdES chỉ hiển thị cho Lãnh đạo (Bí thư, Phó Bí thư, Chánh VP), Văn thư và Quản trị -->
    <menuitem id="menu_aidt_sign_root"
              name="Ký số PAdES"
              sequence="35"
              groups="aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_chanh_vp,aidt_org.group_van_thu,aidt_org.group_aidt_admin"/>
    <menuitem id="menu_aidt_sign_certificate"
              name="Chứng thư số"
              parent="menu_aidt_sign_root"
              action="action_aidt_sign_certificate"
              sequence="10"/>
</odoo>
