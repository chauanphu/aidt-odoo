<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data nodrop="1">
        <record id="module_aidt_sign_category" model="ir.module.category">
            <field name="name">Ký số điện tử</field>
            <field name="description">Quản lý chứng thư và nhật ký ký số PAdES</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_aidt_sign_user" model="res.groups">
            <field name="name">Người dùng ký số</field>
            <field name="category_id" ref="module_aidt_sign_category"/>
        </record>

        <record id="group_aidt_sign_manager" model="res.groups">
            <field name="name">Quản trị chứng thư số</field>
            <field name="category_id" ref="module_aidt_sign_category"/>
            <field name="implied_ids" eval="[(4, ref('group_aidt_sign_user'))]"/>
        </record>
    </data>
</odoo>
