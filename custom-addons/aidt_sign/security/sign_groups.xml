<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_aidt_sign" model="res.groups.privilege">
        <field name="name">Ký số điện tử</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_aidt_sign_user" model="res.groups">
        <field name="name">Người dùng ký số</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_aidt_sign"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_aidt_sign_manager" model="res.groups">
        <field name="name">Quản trị chứng thư số</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_aidt_sign"/>
        <field name="implied_ids" eval="[(4, ref('group_aidt_sign_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_aidt_sign_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>

