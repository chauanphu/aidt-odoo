<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Giá trị mặc định trỏ tới service trong docker-compose.ai.yml. Đổi
         được từ UI, không cần deploy lại. Cùng triết lý với aidt_search.

         19.0.1.2.0 — ĐÃ GỠ sáu tham số của đường vLLM cũ: `asr_url`,
         `asr_api_key`, `asr_response_format`, `asr_temperature`, `llm_url`,
         `llm_api_key`. Chúng phục vụ models/asr_client.py và
         models/summary_client.py, cả hai đã bị xoá khi chuyển sang xử lý
         theo lô ở docker/ai_worker. Để nguyên thì trang Cấu hình vẫn hiện
         những ô mà đổi bao nhiêu cũng không có tác dụng gì — đúng loại lỗi
         đã tốn cả buổi truy: cấu hình ghi `openai/whisper-large-v3` trong
         khi thứ thực sự chạy là `PhoWhisper-small`.

         Odoo tự xoá bản ghi ir.config_parameter khi xml_id biến mất khỏi
         file dữ liệu lúc `-u`, nên không cần migration để dọn giá trị cũ. -->
    <data noupdate="1">
        <!-- Địa chỉ worker xử lý hậu kỳ. `_trigger_ai_service` đọc khoá này
             với mặc định trùng giá trị dưới đây; có bản ghi tường minh để
             đổi được từ UI mà không phải sửa code. -->
        <record id="param_ai_service_url" model="ir.config_parameter">
            <field name="key">aidt_meeting.ai_service_url</field>
            <field name="value">http://ai-worker:8000</field>
        </record>

        <!-- TÊN MODEL THEO CÁCH GỌI CỦA faster-whisper, không phải repo HF.
             Đây chính là chỗ đường cũ và đường mới nói hai ngôn ngữ khác
             nhau: tham số `asr_model` cũ mang giá trị `openai/whisper-large-v3`
             (một repo Hugging Face thường, hợp lệ với vLLM), còn worker chạy
             faster-whisper/CTranslate2 vốn chỉ nhận tên kích cỡ
             (`large-v3`, `medium`, …) hoặc một repo ĐÃ chuyển sang CTranslate2.
             Đưa nhầm giá trị kia sang là lỗi "Invalid model size" ngay lúc
             nạp model — đã xảy ra thật trong log worker với
             `PhoWhisper-large-ct2`.
             Vì vậy đây là KHOÁ RIÊNG chứ không tái dùng tên cũ: hai khoá
             cùng tên mang hai nghĩa là bảo đảm sẽ có người điền nhầm.

             `large-v3` chứ không phải PhoWhisper: PhoWhisper được tinh chỉnh
             trên tiếng Việt ĐỌC (kiểu VLSP) nên nghe đúng nhưng CHỌN SAI TỪ
             trên hội thoại kỹ thuật, không xuất dấu câu và phá nát từ tiếng
             Anh chen vào (bản ghi 1140: "lô cồ" = local, "hỗn hợp" = cuộc
             họp). Đo lại 10/08/2026 trên bản ghi 2797 với PhoWhisper-small:
             "bê đét" = PDF, "ô sơ rờ" = OCR, cả đoạn 42 giây dồn thành một
             khối không dấu câu. large-v3 trên đúng tệp đó cho ra câu tách
             đúng, có dấu, và "tờ trình" ra "tờ trình".

             ĐỔI MODEL THÌ PHẢI XEM LẠI VRAM: large-v3 ở float16 chiếm
             ~3.1 GiB và card này còn chia cho aidt-embed + aidt-llm. int8
             KHÔNG chạy được trên Blackwell (xem docker/ai_worker/main.py). -->
        <record id="param_asr_ct2_model" model="ir.config_parameter">
            <field name="key">aidt_meeting.asr_ct2_model</field>
            <field name="value">large-v3</field>
        </record>

        <!-- Không gửi `language`, Whisper TỰ ĐOÁN ngôn ngữ và một cuộc họp
             tiếng Việt có thể bị bóc thành tiếng Anh ở vài đoạn. Để RỖNG
             nếu muốn dịch vụ tự nhận dạng (họp song ngữ). -->
        <record id="param_asr_language" model="ir.config_parameter">
            <field name="key">aidt_meeting.asr_language</field>
            <field name="value">vi</field>
        </record>

        <!-- MẶC ĐỊNH RỖNG kể từ 19.0.1.2.1. Đây là kết luận từ phép ĐO,
             không phải sở thích — và nó lật ngược hẳn hướng đi trước đó.

             Suốt 19.0.1.1.0 -> 19.0.1.1.1 ta tin rằng vấn đề nằm ở KIỂU
             VIẾT prompt: bản liệt kê gây vòng lặp (bản ghi 1141), nên đổi
             sang văn xuôi là xong. Điều đó SAI. Văn xuôi chỉ làm hỏng hóc
             bớt lộ liễu chứ không chạm tới cơ chế: Whisper coi
             `initial_prompt` là văn bản đứng ngay TRƯỚC audio, nên gặp cửa
             sổ nghèo tín hiệu nó ĐỌC TIẾP đoạn văn đó thay vì phiên âm.

             Đo ngày 10/08/2026, chạy CÙNG một luồng audio, chỉ đổi mỗi
             `initial_prompt`:

               * Bản ghi 2858, luồng Nguyễn Văn An — CÓ prompt: một segment
                 DUY NHẤT trải 44 giây (0.4 -> 44.4) mang nguyên văn prompt,
                 avg_logprob -0.06. KHÔNG prompt: đúng 44 giây đó ra 8 câu
                 thật — "hiện tại dự án đã hoàn thành khoảng 70%", "API đôi
                 khi phản hồi khá chậm", "bổ sung cơ chế caching"…
                 Prompt KHÔNG chèn thêm một dòng rác; nó XOÁ MẤT một nửa
                 phần phát biểu của một người.
               * Bản ghi 2856 (nói đúng một từ "alo" trong 9,5 giây): toàn
                 bộ transcript là một biến thể rút gọn của prompt.
               * Bản ghi 2797 — CÓ prompt 51 segment, KHÔNG prompt 53
                 segment; "PDF", "OCR", "tàu trình" GIỐNG HỆT nhau ở cả hai.
                 Tức phần "mồi vốn từ" KHÔNG đem lại lợi ích đo được nào.

             Lợi ích đo được: 0. Thiệt hại đo được: mất 44 giây nội dung.
             Vì thế mặc định là RỖNG. Ô cấu hình vẫn còn để ai có bộ audio
             riêng chứng minh được là prompt giúp thì bật lại — và
             docker/ai_worker có lưới chắn `is_prompt_echo` cho trường hợp
             đó, nhưng lưới chắn là thứ hứng, không phải lý do để bật.

             `avg_logprob` KHÔNG cứu được: đoạn nhả ngược prompt có logprob
             ĐẸP HƠN hẳn lời nói thật (-0.06 so với -0.43), nên mọi ngưỡng
             độ tự tin đều cho nó đi qua. -->
        <record id="param_asr_prompt" model="ir.config_parameter">
            <field name="key">aidt_meeting.asr_prompt</field>
            <field name="value"></field>
        </record>

        <!-- aidt-llm chạy Ollama (docker-compose.ai.yml), không phải vLLM:
             `model` gửi đi PHẢI khớp NGUYÊN VĂN tag Ollama thật.
             'gemma3:12b-it-qat' là tag chính thức của bản QAT int4 (Q4_0);
             lệch một ký tự là 404 âm thầm.
             ĐỊA CHỈ thì KHÔNG còn ở đây: worker gọi thẳng
             http://aidt-llm:11434/api/chat (khác đường /v1 của bản cũ), đặt
             qua biến môi trường LLM_URL trong docker-compose.ai.yml. Giữ
             lại một ô URL ở giao diện chỉ tạo ra một giá trị không ai đọc. -->
        <record id="param_llm_model" model="ir.config_parameter">
            <field name="key">aidt_meeting.llm_model</field>
            <field name="value">gemma3:12b-it-qat</field>
        </record>

        <record id="param_max_secrecy" model="ir.config_parameter">
            <field name="key">aidt_meeting.max_secrecy</field>
            <field name="value">thuong</field>
        </record>
        <record id="param_audio_retention_days" model="ir.config_parameter">
            <field name="key">aidt_meeting.audio_retention_days</field>
            <field name="value">0</field>
        </record>
    </data>
</odoo>
