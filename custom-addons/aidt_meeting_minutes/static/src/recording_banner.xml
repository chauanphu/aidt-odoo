<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Chèn ngay sau PttAdBanner, đầu template cuộc gọi. Không có registry
         "discuss.call/banners" trong bản Odoo này — đã kiểm chứng bằng grep —
         nên cách duy nhất là mở rộng template bằng t-inherit. Truyền
         `isActiveCall` của chính Call: băng không được hiện chỉ vì
         `recordingId` có giá trị, vì bus broadcast tới cả thành viên kênh
         không có mặt trong cuộc gọi. `channelId` là discuss.channel id thật
         (Thread.id khi model === "discuss.channel"). -->
    <t t-name="aidt_meeting_minutes.CallBanner"
       t-inherit="discuss.Call" t-inherit-mode="extension">
        <xpath expr="//PttAdBanner" position="after">
            <RecordingBanner isActiveCall="isActiveCall" channelId="channel.id"/>
        </xpath>
    </t>

    <t t-name="aidt_meeting_minutes.RecordingBanner">
        <div t-if="isVisible" class="o-aidt-recording-banner"
             t-att-class="{ 'o-aidt-paused': isPaused }">
            <span class="o-aidt-recording-dot"/>
            <span t-esc="label"/>
            <!-- Người dự KHÔNG có nút nào: ghi âm là bắt buộc, và việc
                 tạm dừng/kết thúc thuộc về chủ phòng. -->
            <t t-if="isHost">
                <button t-if="!isPaused" name="pause" class="btn btn-sm btn-secondary"
                        t-on-click="onPause">Tạm dừng</button>
                <button t-if="isPaused" name="resume" class="btn btn-sm btn-secondary"
                        t-on-click="onResume">Ghi tiếp</button>
                <button name="stop" class="btn btn-sm btn-danger"
                        t-on-click="onStop">Kết thúc</button>
            </t>
        </div>
        <div t-if="canStart" class="o-aidt-start-recording">
            <button name="start" class="btn btn-sm btn-outline-danger"
                    t-on-click="onStart">Bật ghi âm biên bản</button>
        </div>
    </t>
</templates>
