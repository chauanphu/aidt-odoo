<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Views for Backend -->
    <record id="view_appointment_registration_tree" model="ir.ui.view">
        <field name="name">aidt.appointment.registration.list</field>
        <field name="model">aidt.appointment.registration</field>
        <field name="arch" type="xml">
            <list string="Đăng ký lịch làm việc">
                <field name="name"/>
                <field name="phone"/>
                <field name="organization"/>
                <field name="preferred_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_registration_form" model="ir.ui.view">
        <field name="name">aidt.appointment.registration.form</field>
        <field name="model">aidt.appointment.registration</field>
        <field name="arch" type="xml">
            <form string="Đăng ký lịch làm việc">
                <header>
                    <button name="action_approve" string="Duyệt đăng ký" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reject" string="Từ chối" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Họ và tên"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="identity_card"/>
                            <field name="organization"/>
                        </group>
                        <group>
                            <field name="preferred_date"/>
                            <field name="event_id" readonly="1" invisible="not event_id"/>
                        </group>
                    </group>
                    <group string="Nội dung đăng ký">
                        <field name="content" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_appointment_registration" model="ir.actions.act_window">
        <field name="name">Đăng ký tiếp dân / làm việc</field>
        <field name="res_model">aidt.appointment.registration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_appointment_registration" parent="calendar.mail_menu_calendar" name="Đăng ký tiếp dân" action="action_appointment_registration" sequence="10"/>

    <!-- Website Portal Template -->
    <template id="appointment_page" name="Đăng ký lịch làm việc / Tiếp công dân">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h2 class="mb-4 text-center">Đăng ký lịch làm việc / Tiếp công dân</h2>
                        <t t-if="error">
                            <div class="alert alert-danger" role="alert">
                                <t t-esc="error"/>
                            </div>
                        </t>
                        <t t-if="submitted">
                            <div class="alert alert-success" role="alert">
                                <h4>Gửi đăng ký thành công!</h4>
                                <p>Yêu cầu đăng ký lịch làm việc của bạn đã được tiếp nhận và đang được xử lý.</p>
                            </div>
                        </t>
                        <t t-else="">
                            <form action="/dang-ky-lich-lam-viec" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label for="name" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="name" name="name" required="required"/>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="phone" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                        <input type="tel" class="form-control" id="phone" name="phone" required="required"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="identity_card" class="form-label">Số CCCD / MST</label>
                                        <input type="text" class="form-control" id="identity_card" name="identity_card"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" name="email"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="organization" class="form-label">Cơ quan / Đơn vị</label>
                                        <input type="text" class="form-control" id="organization" name="organization"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="preferred_date" class="form-label">Thời gian đề xuất <span class="text-danger">*</span></label>
                                    <input type="datetime-local" class="form-control" id="preferred_date" name="preferred_date" required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">Nội dung làm việc <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="content" name="content" rows="4" required="required"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">Gửi đăng ký</button>
                            </form>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
