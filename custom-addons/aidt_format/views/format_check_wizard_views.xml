<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="format_check_line_view_list" model="ir.ui.view">
        <field name="name">aidt.format.check.line.list</field>
        <field name="model">aidt.format.check.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-danger="severity == 'error'"
                  decoration-warning="severity == 'warning'">
                <field name="location" string="Vị trí"/>
                <field name="expected" string="Cần"/>
                <field name="actual" string="Đang"/>
                <field name="suggestion" string="Gợi ý sửa"/>
                <field name="severity" column_invisible="1"/>
                <!-- Ba trường dưới đây cố ý ẩn hẳn, không phải quên bỏ:
                     severity nuôi decoration-danger/warning tô màu từng dòng,
                     còn rule_id và zone là khóa tra ngược về bộ luật khi cần
                     lần lại vì sao có phát hiện này. Xóa thẻ field đi thì
                     client không tải giá trị về và màu dòng mất theo. -->
                <field name="rule_id" column_invisible="1"/>
                <!-- xem ghi chú ở trên -->
                <field name="zone" column_invisible="1"/>
                <!-- xem ghi chú ở trên -->
            </list>
        </field>
    </record>

    <record id="format_check_wizard_view_form" model="ir.ui.view">
        <field name="name">aidt.format.check.wizard.form</field>
        <field name="model">aidt.format.check.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group invisible="da_kiem">
                        <field name="docx_file" filename="filename" string="Tệp .docx"/>
                        <field name="filename" invisible="1"/>
                        <!-- Widget binary ở trên trỏ filename="filename" để
                             lấy tên tệp; trường phải có mặt trong view thì
                             client mới đọc được, nhưng không có gì để người
                             dùng xem hay sửa. -->

                        <field name="ruleset_id"/>
                    </group>
                    <div invisible="not da_kiem">
                        <group>
                            <field name="filename" readonly="1"/>
                            <field name="ruleset_id" readonly="1"/>
                        </group>
                        <div class="alert alert-success" role="alert"
                             invisible="so_loi != 0 or so_canh_bao != 0">
                            Đạt — không phát hiện lỗi thể thức nào.
                        </div>
                        <div class="alert alert-danger" role="alert"
                             invisible="so_loi == 0">
                            <field name="so_loi" nolabel="1" class="oe_inline"/>
                            lỗi chặn —
                            <field name="so_canh_bao" nolabel="1" class="oe_inline"/>
                            cảnh báo.
                        </div>
                        <div class="alert alert-warning" role="alert"
                             invisible="so_loi != 0 or so_canh_bao == 0">
                            Không có lỗi chặn —
                            <field name="so_canh_bao" nolabel="1" class="oe_inline"/>
                            cảnh báo.
                        </div>
                        <field name="line_ids" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_kiem_tra" string="Kiểm tra" type="object"
                            class="btn-primary" invisible="da_kiem"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="format_check_wizard_action" model="ir.actions.act_window">
        <field name="name">Kiểm tra thể thức</field>
        <field name="res_model">aidt.format.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Mục đầu tiên của ứng dụng: đây là việc văn thư làm hằng ngày, còn
         sửa bộ luật là việc quản trị viên thỉnh thoảng mới làm. -->
    <menuitem id="menu_aidt_format_check_wizard"
              name="Kiểm tra thể thức"
              parent="menu_aidt_format_root"
              action="format_check_wizard_action"
              groups="base.group_user"
              sequence="10"/>

</odoo>
