<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dynamic_dashboard_tree" model="ir.ui.view">
        <field name="name">dynamic.dashboard.list</field>
        <field name="model">dynamic.dashboard</field>
        <field name="arch" type="xml">
            <list string="Danh sách Dashboard">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="company_id"/>
                <field name="state" widget="badge" decoration-success="state == 'published'" decoration-info="state == 'draft'"/>
                <field name="theme"/>
                <field name="is_default"/>
                <button name="action_view_dashboard" string="Xem Dashboard" type="object" icon="fa-eye" class="btn-sm btn-outline-primary"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_dashboard_form" model="ir.ui.view">
        <field name="name">dynamic.dashboard.form</field>
        <field name="model">dynamic.dashboard</field>
        <field name="arch" type="xml">
            <form string="Cấu hình Dashboard">
                <header>
                    <button name="action_publish" string="Xuất bản Dashboard" type="object" class="btn-success" invisible="state == 'published'"/>
                    <button name="action_set_draft" string="Chuyển về Dự thảo" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_view_dashboard" string="Xem Dashboard này" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên Dashboard (Ví dụ: Dashboard Quản lý Văn bản)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="owner_id"/>
                            <field name="company_id"/>
                            <field name="theme"/>
                            <field name="refresh_interval"/>
                            <field name="is_default"/>
                            <field name="is_template"/>
                        </group>
                        <group string="Phân quyền &amp; Chia sẻ">
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="viewer_ids" widget="many2many_tags"/>
                            <field name="designer_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trang / Tabs" name="pages">
                            <field name="page_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="icon"/>
                                </list>
                            </field>
                        </page>
                        <page string="Widgets" name="widgets">
                            <field name="widget_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="widget_type"/>
                                    <field name="model_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bộ lọc dùng chung (Global Filters)" name="filters">
                            <field name="filter_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="filter_type"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú &amp; Mô tả" name="description">
                            <field name="description" placeholder="Mô tả mục đích của Dashboard này..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dynamic_dashboard" model="ir.actions.act_window">
        <field name="name">Quản lý Dashboards</field>
        <field name="res_model">dynamic.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
