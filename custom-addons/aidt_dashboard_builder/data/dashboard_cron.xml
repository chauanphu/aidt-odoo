<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job tự động xóa Cache truy vấn đã hết hạn để giải phóng dung lượng DB -->
        <record id="cron_clean_dashboard_cache" model="ir.cron">
            <field name="name">Dynamic Dashboard: Cleanup Expired Query Cache</field>
            <field name="model_id" ref="model_dynamic_dashboard_cache"/>
            <field name="state">code</field>
            <field name="code">
now = datetime.datetime.now()
env['dynamic.dashboard.cache'].sudo().search([('expires_at', '&lt;', now)]).unlink()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
