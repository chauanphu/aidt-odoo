<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aidt_dashboard_builder.DashboardViewerAction">
        <div class="o_dashboard_viewer_container d-flex flex-column h-100">
            <!-- Integrated Modern Responsive Dashboard Header -->
            <div class="o_dashboard_header d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 px-3 px-md-4 py-2.5 py-md-3">
                <div class="d-flex align-items-center justify-content-between w-100 w-md-auto gap-2">
                    <!-- Custom Premium Dashboard Selector Dropdown -->
                    <div class="dropdown dashboard-dropdown position-relative flex-grow-1 flex-md-grow-0">
                        <button class="btn btn-dashboard-select d-flex align-items-center justify-content-between gap-2.5 px-3 py-2 shadow-sm rounded-3 bg-white cursor-pointer w-100"
                                type="button"
                                t-on-click="toggleDropdown">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <div class="dashboard-picker-icon-badge flex-shrink-0">
                                    <i class="fa fa-th-large"></i>
                                </div>
                                <span class="fw-bold text-dark text-truncate dashboard-title-text">
                                    <t t-esc="currentDashboardName"/>
                                </span>
                            </div>
                            <i t-attf-class="fa {{state.dropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down'}} text-muted small ms-2 flex-shrink-0"></i>
                        </button>
                        <ul t-attf-class="dropdown-menu dropdown-menu-start shadow-lg border-0 rounded-4 py-2 mt-2 me-0 {{state.dropdownOpen ? 'show' : ''}}"
                            style="min-width: 280px; max-width: 100vw; max-height: 340px; overflow-y: auto; z-index: 1055;">
                            <t t-foreach="state.availableDashboards" t-as="d" t-key="d.id">
                                <li>
                                    <a t-attf-class="dropdown-item d-flex align-items-center justify-content-between py-2.5 px-3 {{d.id == state.dashboardId ? 'active' : ''}}"
                                       href="#"
                                       t-on-click.prevent="() => this.selectDashboard(d.id)">
                                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                                            <i t-attf-class="fa {{d.id == state.dashboardId ? 'fa-check-circle text-purple' : 'fa-circle-o text-muted'}} flex-shrink-0"></i>
                                            <span class="text-truncate fw-semibold"><t t-esc="d.name"/></span>
                                        </div>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </div>

                    <!-- Mobile Refresh Icon Button -->
                    <button class="btn btn-refresh rounded-circle d-md-none p-2.5 flex-shrink-0"
                            t-on-click="onRefreshClick"
                            title="Làm mới dữ liệu">
                        <i class="fa fa-refresh"></i>
                    </button>
                </div>

                <!-- Desktop / Tablet Action Controls Group -->
                <div class="dashboard-header-actions d-flex flex-wrap align-items-center justify-content-end gap-2 ms-auto ms-md-0 w-100 w-md-auto">
                    <t t-if="state.lastUpdated">
                        <span class="text-muted small fw-semibold me-md-2 d-none d-sm-inline-flex align-items-center">
                            <i class="fa fa-clock-o me-1 text-primary"></i> Cập nhật <t t-esc="state.lastUpdated"/>
                        </span>
                    </t>

                    <button class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold flex-grow-1 flex-sm-grow-0"
                            t-on-click="onExportExcel"
                            title="Xuất Báo cáo Dashboard ra file Excel chuyên nghiệp">
                        <i class="fa fa-file-excel-o me-1"></i> <span class="d-none d-xs-inline">Xuất</span> Excel
                    </button>

                    <t t-if="state.hasCustomLayout &amp;&amp; !state.editMode">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold flex-grow-1 flex-sm-grow-0"
                                t-on-click="resetLayout"
                                title="Khôi phục sắp xếp về mặc định của Admin">
                            <i class="fa fa-undo me-1"></i> <span class="d-none d-xs-inline">Khôi phục</span> Mặc định
                        </button>
                    </t>

                    <button t-attf-class="btn btn-sm rounded-pill px-3.5 py-1.5 fw-semibold flex-grow-1 flex-sm-grow-0 {{state.editMode ? 'btn-purple-active' : 'btn-outline-purple'}}"
                            t-on-click="toggleEditMode">
                        <i t-attf-class="fa {{state.editMode ? 'fa-times' : 'fa-sliders'}} me-1.5"></i>
                        <t t-if="state.editMode">Thoát Chỉnh Sửa</t>
                        <t t-else="">Sắp Xếp Layout</t>
                    </button>

                    <button class="btn btn-refresh rounded-pill px-3.5 py-1.5 fw-semibold btn-sm d-none d-md-inline-flex align-items-center"
                            t-on-click="onRefreshClick">
                        <i class="fa fa-refresh me-2"></i> Làm mới
                    </button>
                </div>
            </div>

            <!-- Cascading Master Filters & Date Pills Toolbar -->
            <DashboardFilterBar activeFilterPill="state.activeFilterPill" filters="state.filters || []" onDatePillChange="(pillId) => this.onDatePillChange(pillId)" onFilterChange="(name, val) => this.onGlobalFilterChange(name, val)"/>

            <!-- Edit Mode Banner Bar (Responsive Flex Container) -->
            <t t-if="state.editMode">
                <div class="o_dashboard_edit_banner px-3 px-md-4 py-2.5 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 shadow-inner">
                    <div class="d-flex align-items-center gap-2 text-purple fw-semibold small">
                        <i class="fa fa-arrows fs-6 flex-shrink-0"></i>
                        <span>Kéo thả di chuyển vị trí và rê góc ↘ để co giãn 2 chiều.</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 w-100 w-sm-auto justify-content-end">
                        <button class="btn btn-sm btn-outline-purple rounded-pill px-3 py-1.5 fw-semibold flex-grow-1 flex-sm-grow-0"
                                t-on-click="() => this.autoCompactLayout()"
                                title="Tự động căn chỉnh và loại bỏ khoảng trống dư thừa giữa các Widget">
                            <i class="fa fa-compress me-1.5"></i> Căn chỉnh dồn gọn
                        </button>
                        <button class="btn btn-sm btn-purple rounded-pill px-3.5 py-1.5 fw-bold shadow-sm flex-grow-1 flex-sm-grow-0"
                                t-on-click="toggleSidebar">
                            <i class="fa fa-plus me-1.5"></i> Thêm Widget
                        </button>
                        <button class="btn btn-sm btn-success rounded-pill px-3.5 py-1.5 fw-bold shadow-sm flex-grow-1 flex-sm-grow-0"
                                t-att-disabled="state.savingLayout"
                                t-on-click="() => this.saveLayout(true)">
                            <i class="fa fa-save me-1.5"></i> Lưu Layout
                        </button>
                        <button class="btn btn-sm btn-light border rounded-pill px-3 text-muted flex-grow-1 flex-sm-grow-0"
                                t-on-click="toggleEditMode">
                            Hủy
                        </button>
                    </div>
                </div>
            </t>

            <!-- Page Tabs Bar (Horizontally Scrollable Segmented Navigation) -->
            <t t-if="state.pages &amp;&amp; state.pages.length > 0">
                <div class="o_dashboard_page_tabs px-3 px-md-4">
                    <div class="nav-tabs-wrapper overflow-x-auto text-nowrap py-1">
                        <t t-foreach="state.pages" t-as="page" t-key="page.id">
                            <button t-attf-class="btn btn-tab {{state.activePageId == page.id ? 'active' : ''}}"
                                    t-on-click="() => this.onPageSelect(page.id)">
                                <i t-attf-class="fa {{page.icon ? page.icon : 'fa-folder-o'}} tab-icon"></i>
                                <span><t t-esc="page.name"/></span>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Loading Spinner State -->
            <t t-if="state.loading">
                <div class="dash-loading-skeleton d-flex flex-grow-1 align-items-center justify-content-center py-5">
                    <div class="text-center p-4 dash-animate-scale">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="text-muted fw-semibold mb-0">Đang nạp dữ liệu Dashboard...</p>
                    </div>
                </div>
            </t>

            <!-- Responsive Access Restricted / Empty State -->
            <t t-elif="state.error || (!state.loading &amp;&amp; (!state.availableDashboards || state.availableDashboards.length === 0))">
                <div class="d-flex flex-grow-1 align-items-center justify-content-center p-3 p-md-5">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5 bg-white w-100 dash-animate-scale" style="max-width: 480px;">
                        <div class="dashboard-access-icon-wrapper mb-3 mx-auto d-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning">
                            <i class="fa fa-lock fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2 fs-5 fs-md-4">Chưa có quyền xem Dashboard</h4>
                        <p class="text-muted small mb-4" style="line-height: 1.6;">
                            <t t-if="state.error">
                                <t t-esc="state.error"/>
                            </t>
                            <t t-else="">
                                Tài khoản của bạn chưa được phân quyền truy cập Dashboard này hoặc chưa có Dashboard nào được xuất bản. Vui lòng liên hệ Quản trị viên để được cấp quyền.
                            </t>
                        </p>
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold" t-on-click="onRefreshClick">
                                <i class="fa fa-refresh me-1.5"></i> Thử lại
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Dashboard Widgets Canvas Grid (Responsive Wrapper Container) -->
            <t t-else="">
                <div class="dashboard-canvas-scroll-container container-fluid p-2 p-sm-3 p-md-4 flex-grow-1 overflow-auto">
                    <!-- TRƯỜNG HỢP DASHBOARD CHƯA CÓ WIDGET NÀO -->
                    <t t-if="!allVisibleWidgets || allVisibleWidgets.length === 0">
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5 text-center px-3 dash-animate-in">
                            <div class="bg-white rounded-circle shadow-sm p-4 mb-3">
                                <i class="fa fa-dashboard fs-1 text-primary opacity-75"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Dashboard chưa có Widget</h5>
                            <p class="text-muted small mb-0" style="max-width: 420px;">
                                Hãy truy cập menu <strong>Cấu hình Widgets</strong> để thiết kế KPI, biểu đồ, bảng dữ liệu hoặc phím tắt cho Dashboard này.
                            </p>
                        </div>
                    </t>

                    <t t-else="">
                        <!-- MODE CHỈNH SỬA LAYOUT (GRIDSTACK 12 CỘT DRAG & DROP CANVAS) -->
                        <t t-if="state.editMode">
                            <div class="grid-stack grid-stack-canvas mb-4">
                                <t t-foreach="state.editedWidgets" t-as="item" t-key="item.id">
                                    <div class="grid-stack-item"
                                         t-att-gs-id="item.id"
                                         t-att-gs-x="item.x"
                                         t-att-gs-y="item.y"
                                         t-att-gs-w="item.w"
                                         t-att-gs-h="item.h"
                                         t-att-gs-min-w="getMinW(item.widget_type)"
                                         t-att-gs-min-h="getMinH(item.widget_type)">
                                        <div class="grid-stack-item-content p-2 rounded-4 bg-white border border-2 border-purple-dashed shadow-sm d-flex flex-column h-100 overflow-hidden">
                                            <!-- Widget Edit Toolbar Bar -->
                                            <div class="widget-edit-toolbar d-flex align-items-center justify-content-between p-2 mb-2 bg-purple-subtle rounded-3 cursor-grab flex-shrink-0" style="user-select: none;">
                                                <div class="d-flex align-items-center gap-2 overflow-hidden me-1">
                                                    <i class="fa fa-arrows text-purple drag-handle-icon flex-shrink-0" title="Giữ và kéo thả vị trí"></i>
                                                    <span class="badge bg-purple text-white fw-bold flex-shrink-0">#<t t-esc="item_index + 1"/></span>
                                                    <span class="fw-bold text-dark text-truncate small"><t t-esc="item.name"/></span>
                                                </div>
                                                <span class="badge bg-light text-muted border extra-small-badge fw-normal flex-shrink-0 d-none d-sm-inline-block">
                                                    <i class="fa fa-hand-rock-o me-1"></i>Kéo &amp; co giãn
                                                </span>
                                            </div>

                                            <!-- Live Preview of Widget -->
                                            <div class="widget-preview-wrapper flex-grow-1 overflow-auto h-100">
                                                <t t-set="WComponent" t-value="getWidgetComponent(item.widget_type)"/>
                                                <t t-if="WComponent">
                                                    <t t-component="WComponent" widget="{id: item.id, widget_type: item.widget_type, name: item.name}" data="item.data"/>
                                                </t>
                                            </div>

                                            <!-- Visual Resize Grip Handle Indicator -->
                                            <div class="resize-handle-grip position-absolute bottom-0 end-0 p-1 me-1 mb-1" style="pointer-events: none; opacity: 0.85; z-index: 10;">
                                                <i class="fa fa-arrows-alt text-purple" style="font-size: 0.8rem;" title="Rê chuột góc dưới bên phải để co giãn 2 chiều"></i>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- MODE XEM NORMAL VIEW (GRIDSTACK STATIC CANVAS) -->
                        <t t-else="">
                            <div class="grid-stack grid-stack-view-canvas mb-4">
                                <t t-foreach="allVisibleWidgets" t-as="item" t-key="item.id">
                                    <div class="grid-stack-item"
                                         t-att-gs-id="item.id"
                                         t-att-gs-x="item.x"
                                         t-att-gs-y="item.y"
                                         t-att-gs-w="item.w"
                                         t-att-gs-h="item.h"
                                         t-att-gs-min-w="getMinW(item.widget_type)"
                                         t-att-gs-min-h="getMinH(item.widget_type)">
                                        <div class="grid-stack-item-content p-0 bg-transparent border-0 shadow-none d-flex flex-column h-100 overflow-hidden">
                                            <t t-set="WComponent" t-value="getWidgetComponent(item.widget_type)"/>
                                            <t t-if="WComponent">
                                                <t t-component="WComponent" widget="{id: item.id, widget_type: item.widget_type, name: item.name, drilldown_action_id: item.data.drilldown_action_id}" data="item.data" onDrilldown="onDrilldown"/>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
            <!-- Drag & Drop Sidebar Widget Palette Drawer -->
            <WidgetLibrarySidebar isOpen="state.sidebarOpen" onClose="() => this.toggleSidebar()" onAddWidget="(preset) => this.onAddPresetWidget(preset)"/>
        </div>
    </t>
</templates>

