<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Unified Top-Level Application Menu -->
    <menuitem id="menu_aidt_document_unified_root"
              name="Văn bản"
              web_icon="aidt_vanban_den,static/description/icon.png"
              sequence="1"
              active="1"/>

    <!-- Categories under Unified Root Menu -->
    <menuitem id="menu_vanban_den_cate"
              name="Văn bản đến"
              parent="menu_aidt_document_unified_root"
              sequence="10"/>

    <menuitem id="menu_vanban_di_cate"
              name="Văn bản đi"
              parent="menu_aidt_document_unified_root"
              sequence="20"/>

    <menuitem id="menu_so_vanban_cate"
              name="Sổ Văn bản"
              parent="menu_aidt_document_unified_root"
              sequence="30"/>

    <!-- Re-parent Sub-menus for Văn bản đến -->
    <menuitem id="menu_vanban_den_all"
              name="Tất cả Văn bản đến"
              parent="menu_vanban_den_cate"
              action="action_vanban_den"
              sequence="10"/>

    <menuitem id="menu_vanban_den_cho_but_phe"
              name="Chờ bút phê"
              parent="menu_vanban_den_cate"
              action="action_vanban_den_cho_but_phe"
              sequence="20"/>

    <menuitem id="menu_vanban_den_dang_xu_ly"
              name="Đang xử lý"
              parent="menu_vanban_den_cate"
              action="action_vanban_den_dang_xu_ly"
              sequence="30"/>

    <menuitem id="menu_vanban_den_qua_han"
              name="Quá hạn xử lý"
              parent="menu_vanban_den_cate"
              action="action_vanban_den_qua_han"
              sequence="40"/>

    <!-- Re-parent Sub-menus for Văn bản đi -->
    <menuitem id="aidt_vanban_di.menu_vanban_di_tat_ca"
              name="Tất cả Văn bản đi"
              parent="menu_vanban_di_cate"
              action="aidt_vanban_di.action_vanban_di"
              sequence="10"/>

    <menuitem id="aidt_vanban_di.menu_vanban_di_cho_duyet"
              name="Chờ duyệt"
              parent="menu_vanban_di_cate"
              action="aidt_vanban_di.action_vanban_di_cho_duyet"
              sequence="20"/>

    <menuitem id="aidt_vanban_di.menu_vanban_di_cho_ky"
              name="Chờ ký"
              parent="menu_vanban_di_cate"
              action="aidt_vanban_di.action_vanban_di_cho_ky"
              sequence="30"/>

    <menuitem id="aidt_vanban_di.menu_vanban_di_cho_cap_so"
              name="Chờ cấp số &amp; ban hành"
              parent="menu_vanban_di_cate"
              action="aidt_vanban_di.action_vanban_di_cho_cap_so"
              sequence="35"/>

    <menuitem id="aidt_vanban_di.menu_vanban_di_da_ban_hanh"
              name="Đã ban hành"
              parent="menu_vanban_di_cate"
              action="aidt_vanban_di.action_vanban_di_da_ban_hanh"
              sequence="40"/>

    <menuitem id="aidt_vanban_di.menu_aidt_document_template_di"
              name="Mẫu văn bản"
              parent="menu_vanban_di_cate"
              action="aidt_vanban_di.aidt_document_template_action"
              sequence="50"/>

    <!-- Sub-menus for Sổ Văn bản -->
    <menuitem id="menu_so_vanban_den"
              name="Sổ Văn bản đến"
              parent="menu_so_vanban_cate"
              action="action_report_so_vanban_den"
              sequence="10"/>

    <menuitem id="menu_so_vanban_di"
              name="Sổ Văn bản đi"
              parent="menu_so_vanban_cate"
              action="aidt_vanban_di.action_report_so_vanban_di"
              sequence="20"/>

    <!-- Deactivate Legacy Root Menus -->
    <record id="menu_vanban_den_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="aidt_vanban_di.menu_vanban_di_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
