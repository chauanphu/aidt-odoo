<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_vanban_den" model="ir.actions.act_window">
        <field name="name">Văn bản đến</field>
        <field name="res_model">aidt.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('direction', '=', 'den')]</field>
        <field name="context">{'default_direction': 'den', 'default_state': 'tiep_nhan'}</field>
        <field name="search_view_id" ref="aidt_vanban_den_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('aidt_vanban_den_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('aidt_vanban_den_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('aidt_vanban_den_view_form')})]"/>
    </record>

    <record id="action_vanban_den_cho_but_phe" model="ir.actions.act_window">
        <field name="name">Chờ bút phê</field>
        <field name="res_model">aidt.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('direction', '=', 'den'), ('state', '=', 'trinh_lanh_dao')]</field>
        <field name="context">{'default_direction': 'den', 'default_state': 'tiep_nhan'}</field>
        <field name="search_view_id" ref="aidt_vanban_den_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('aidt_vanban_den_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('aidt_vanban_den_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('aidt_vanban_den_view_form')})]"/>
    </record>

    <record id="action_vanban_den_dang_xu_ly" model="ir.actions.act_window">
        <field name="name">Đang xử lý</field>
        <field name="res_model">aidt.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('direction', '=', 'den'), ('state', '=', 'dang_xu_ly')]</field>
        <field name="context">{'default_direction': 'den', 'default_state': 'tiep_nhan'}</field>
        <field name="search_view_id" ref="aidt_vanban_den_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('aidt_vanban_den_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('aidt_vanban_den_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('aidt_vanban_den_view_form')})]"/>
    </record>

    <record id="action_vanban_den_qua_han" model="ir.actions.act_window">
        <field name="name">Quá hạn</field>
        <field name="res_model">aidt.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('direction', '=', 'den'), ('is_overdue', '=', True)]</field>
        <field name="context">{'default_direction': 'den', 'default_state': 'tiep_nhan'}</field>
        <field name="search_view_id" ref="aidt_vanban_den_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('aidt_vanban_den_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('aidt_vanban_den_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('aidt_vanban_den_view_form')})]"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_vanban_den_root"
              name="Văn bản đến"
              web_icon="aidt_vanban_den,static/description/icon.png"
              sequence="1"/>

    <menuitem id="menu_vanban_den_all"
              name="Tất cả văn bản đến"
              parent="menu_vanban_den_root"
              action="action_vanban_den"
              sequence="10"/>

    <menuitem id="menu_vanban_den_cho_but_phe"
              name="Chờ bút phê"
              parent="menu_vanban_den_root"
              action="action_vanban_den_cho_but_phe"
              sequence="20"/>

    <menuitem id="menu_vanban_den_dang_xu_ly"
              name="Đang xử lý"
              parent="menu_vanban_den_root"
              action="action_vanban_den_dang_xu_ly"
              sequence="30"/>

    <menuitem id="menu_vanban_den_qua_han"
              name="Quá hạn"
              parent="menu_vanban_den_root"
              action="action_vanban_den_qua_han"
              sequence="40"/>
</odoo>
