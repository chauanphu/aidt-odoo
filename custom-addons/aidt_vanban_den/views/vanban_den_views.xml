<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated Standalone Form View for Incoming Documents -->
    <record id="aidt_vanban_den_view_form" model="ir.ui.view">
        <field name="name">aidt.document.form.vanban.den</field>
        <field name="model">aidt.document</field>
        <field name="arch" type="xml">
            <form string="Văn bản đến">
                <header>
                    <button name="action_register" string="Cấp số đến" type="object"
                            class="btn-primary"
                            groups="aidt_org.group_van_thu,aidt_org.group_aidt_admin"
                            invisible="state != 'tiep_nhan'"/>
                    <button name="action_submit_leader" string="Trình lãnh đạo" type="object"
                            class="btn-primary"
                            groups="aidt_org.group_van_thu,aidt_org.group_chanh_vp,aidt_org.group_aidt_admin"
                            invisible="state != 'da_dang_ky'"/>
                    <button name="action_but_phe" string="Bút phê + Giao việc" type="object"
                            class="btn-primary"
                            groups="aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_chanh_vp,aidt_org.group_aidt_admin"
                            invisible="state != 'trinh_lanh_dao'"/>
                    <button name="action_complete" string="Duyệt hoàn thành" type="object"
                            class="btn-primary"
                            groups="aidt_org.group_chanh_vp,aidt_org.group_bi_thu,aidt_org.group_aidt_admin"
                            invisible="state != 'dang_xu_ly'"/>
                    <button name="%(aidt_dms.action_aidt_document_ocr_wizard)d" string="Trích xuất AI (OCR)" type="action"
                            class="btn-info" icon="fa-magic"
                            help="Tải tệp/ảnh scan để AI tự động trích xuất thông tin công văn giấy"
                            invisible="state not in ('tiep_nhan', 'da_dang_ky')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="tiep_nhan,da_dang_ky,trinh_lanh_dao,dang_xu_ly,hoan_thanh"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="1"/>
                    <widget name="web_ribbon" title="Quá hạn" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_extract_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Nhiệm vụ"/>
                        </button>
                        <button type="object" name="action_open_files"
                                class="oe_stat_button" icon="fa-folder-open">
                            <field name="file_count" widget="statinfo" string="Tệp đính kèm"/>
                        </button>
                    </div>
                    <group>
                        <group name="group_left">
                            <field name="name" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="reference" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="doc_type" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="secrecy" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="do_khan" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                        </group>
                        <group name="group_right">
                            <field name="direction" invisible="1"/>
                            <field name="so_den" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="ngay_den" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="co_quan_gui" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="so_ky_hieu_gui" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="ngay_ban_hanh_gui" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="so_ban" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="department_id" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="date" string="Ngày tiếp nhận" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                            <field name="shared_user_ids" widget="many2many_tags" readonly="state in ['trinh_lanh_dao', 'dang_xu_ly', 'hoan_thanh']"/>
                        </group>
                    </group>
                    <notebook name="document_notebook">
                        <page string="Bút phê / Chỉ đạo" name="page_but_phe"
                              invisible="state in ('tiep_nhan', 'da_dang_ky')">
                            <group groups="aidt_org.group_bi_thu,aidt_org.group_pho_bi_thu,aidt_org.group_chanh_vp,aidt_org.group_aidt_admin">
                                <group>
                                    <field name="lanh_dao_but_phe_id" readonly="state != 'trinh_lanh_dao'"/>
                                    <field name="don_vi_chu_tri_id" readonly="state != 'trinh_lanh_dao'"/>
                                    <field name="don_vi_phoi_hop_ids" widget="many2many_tags" readonly="state != 'trinh_lanh_dao'"/>
                                    <field name="han_xu_ly" readonly="state != 'trinh_lanh_dao'"/>
                                </group>
                                <group>
                                    <field name="y_kien_but_phe" readonly="state != 'trinh_lanh_dao'"/>
                                </group>
                            </group>
                            <group groups="!aidt_org.group_bi_thu,!aidt_org.group_pho_bi_thu,!aidt_org.group_chanh_vp,!aidt_org.group_aidt_admin">
                                <group>
                                    <field name="lanh_dao_but_phe_id" readonly="1"/>
                                    <field name="don_vi_chu_tri_id" readonly="1"/>
                                    <field name="don_vi_phoi_hop_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="han_xu_ly" readonly="1"/>
                                </group>
                                <group>
                                    <field name="y_kien_but_phe" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tệp đính kèm" name="files">
                            <group string="Tải tệp đính kèm mới" invisible="state not in ('tiep_nhan', 'da_dang_ky')">
                                <group>
                                    <field name="upload_file" filename="upload_filename" string="Chọn tệp đính kèm"/>
                                    <field name="upload_filename" invisible="1"/>
                                </group>
                                <group>
                                    <button name="action_save_upload_file" string="Lưu tệp đính kèm" type="object" class="btn-primary" icon="fa-upload" invisible="not upload_file"/>
                                </group>
                            </group>
                            <field name="file_ids" readonly="1">
                                <list>
                                    <field name="name" string="Tên tệp"/>
                                    <field name="mimetype" string="Định dạng"/>
                                    <field name="human_size" string="Dung lượng"/>
                                    <field name="create_date" string="Ngày tải lên"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="aidt_vanban_den_view_list" model="ir.ui.view">
        <field name="name">aidt.document.list.vanban.den</field>
        <field name="model">aidt.document</field>
        <field name="arch" type="xml">
            <list string="Văn bản đến" decoration-danger="is_overdue">
                <field name="is_overdue" column_invisible="True"/>
                <field name="so_den"/>
                <field name="name"/>
                <field name="co_quan_gui"/>
                <field name="doc_type" optional="show"/>
                <field name="do_khan" widget="badge" decoration-danger="do_khan in ('hoa_toc', 'thuong_khan')" decoration-warning="do_khan == 'khan'"/>
                <field name="secrecy" widget="badge"
                       decoration-danger="secrecy in ('toi_mat', 'tuyet_mat')"
                       decoration-warning="secrecy == 'mat'"
                       decoration-muted="secrecy == 'thuong'"
                       optional="show"/>
                <field name="ngay_den"/>
                <field name="han_xu_ly" widget="remaining_days"/>
                <field name="don_vi_chu_tri_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('tiep_nhan', 'draft')"
                       decoration-warning="state in ('da_dang_ky', 'trinh_lanh_dao')"
                       decoration-primary="state == 'dang_xu_ly'"
                       decoration-success="state in ('da_but_phe', 'hoan_thanh')"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="aidt_vanban_den_view_kanban" model="ir.ui.view">
        <field name="name">aidt.document.kanban.vanban.den</field>
        <field name="model">aidt.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <field name="do_khan"/>
                <field name="so_den"/>
                <field name="name"/>
                <field name="co_quan_gui"/>
                <field name="han_xu_ly"/>
                <field name="file_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="so_den"/> - <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="do_khan" widget="label_selection" options="{'classes': {'thuong': 'default', 'khan': 'warning', 'thuong_khan': 'danger', 'hoa_toc': 'danger'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-building" title="Cơ quan gửi"></i> <field name="co_quan_gui"/></div>
                                <div t-if="record.han_xu_ly.raw_value"><i class="fa fa-clock-o" title="Hạn xử lý"></i> <field name="han_xu_ly"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span title="Tệp đính kèm"><i class="fa fa-paperclip"/> <field name="file_count"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="aidt_vanban_den_view_search" model="ir.ui.view">
        <field name="name">aidt.document.search.vanban.den</field>
        <field name="model">aidt.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="so_den"/>
                <field name="co_quan_gui"/>
                <field name="so_ky_hieu_gui"/>
                <filter string="Quá hạn" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Chờ bút phê" name="filter_cho_but_phe" domain="[('state', '=', 'trinh_lanh_dao')]"/>
                <filter string="Đang xử lý" name="filter_dang_xu_ly" domain="[('state', '=', 'dang_xu_ly')]"/>
                <filter string="Hôm nay" name="filter_hom_nay" domain="[('ngay_den', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Mật trở lên" name="filter_mat" domain="[('secrecy', '!=', 'thuong')]"/>
                <group>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Đơn vị chủ trì" name="group_by_don_vi" context="{'group_by': 'don_vi_chu_tri_id'}"/>
                    <filter string="Độ khẩn" name="group_by_do_khan" context="{'group_by': 'do_khan'}"/>
                    <filter string="Cơ quan gửi" name="group_by_co_quan_gui" context="{'group_by': 'co_quan_gui'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
