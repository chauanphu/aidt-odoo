<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record id="cat_van_ban" model="tile.category">
            <field name="name">Văn phòng cấp ủy</field>
        </record>

        <record id="tile_tong_vb" model="tile.tile">
            <field name="name">Tổng văn bản</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#1F6FB2</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_mat" model="tile.tile">
            <field name="name">Văn bản Mật trở lên</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('secrecy','!=','thuong')]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#E67E22</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_toimat" model="tile.tile">
            <field name="name">Tối mật / Tuyệt mật</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('secrecy','in',['toi_mat','tuyet_mat'])]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#C0392B</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_draft" model="tile.tile">
            <field name="name">Dự thảo chưa ban hành</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('state','=','draft')]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#F39C12</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_issued" model="tile.tile">
            <field name="name">Đã ban hành</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('state','=','issued')]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#27AE60</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_tep_vb" model="tile.tile">
            <field name="name">Tệp văn bản</field>
            <field name="sequence">60</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="dms.model_dms_file" />
            <field name="domain">[('res_model','=','aidt.document')]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#16A085</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <!-- Phase 4 Tiles -->
        <record id="tile_vb_den_cho_but_phe" model="tile.tile">
            <field name="name">VB Đến chờ bút phê</field>
            <field name="sequence">70</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('direction','=','den'),('state','=','trinh_lanh_dao')]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#E74C3C</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_den_qua_han" model="tile.tile">
            <field name="name">VB Đến quá hạn</field>
            <field name="sequence">80</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('direction','=','den'),('is_overdue','=',True)]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#900C3F</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_di_trinh_ky" model="tile.tile">
            <field name="name">VB Đi đang trình duyệt/ký</field>
            <field name="sequence">90</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('direction','=','di'),('state','in',['trinh_duyet','cho_duyet_tp','cho_duyet_cvp','cho_duyet_lanh_dao','cho_ky'])]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#2980B9</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="tile_vb_di_da_ban_hanh" model="tile.tile">
            <field name="name">VB Đi đã ban hành</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="cat_van_ban" />
            <field name="model_id" ref="aidt_org.model_aidt_document" />
            <field name="domain">[('direction','=','di'),('state','=','da_ban_hanh')]</field>
            <field name="primary_function">count</field>
            <field name="background_color">#27AE60</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <!-- Action mở 6 ô KPI dạng CARD (kanban), không phải list config -->
        <record id="action_dashboard_van_ban" model="ir.actions.act_window">
            <field name="name">Bảng điều khiển văn bản</field>
            <field name="res_model">tile.tile</field>
            <field name="view_mode">kanban</field>
            <field name="domain" eval="[('category_id', '=', ref('cat_van_ban'))]" />
            <field name="context">{'create': False, 'edit': False}</field>
        </record>

        <!-- Menu ứng dụng cũ đã được thay thế bởi aidt_dashboard_builder -->
        <menuitem id="menu_dashboard_root"
                  name="Bảng điều khiển"
                  sequence="1"
                  active="0" />
        <menuitem id="menu_dashboard_van_ban"
                  name="Tổng quan văn bản"
                  parent="menu_dashboard_root"
                  action="action_dashboard_van_ban"
                  sequence="10"
                  active="0" />

    </data>

    <data>
        <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
                model="ir.ui.menu">
            <field name="active" eval="False" />
        </record>
    </data>
</odoo>
