<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action cho Dashboard Viewer -->
    <record id="action_dashboard_viewer_client" model="ir.actions.client">
        <field name="name">Màn hình Dashboard</field>
        <field name="tag">action_dashboard_viewer</field>
    </record>

    <!-- Menu Gốc Dashboard Builder -->
    <menuitem id="menu_dynamic_dashboard_root"
              name="Dashboard"
              web_icon="aidt_dashboard_builder,static/description/icon.png"
              groups="base.group_user"
              sequence="1"/>

    <!-- Menu Con: Dashboard Trực quan -->
    <menuitem id="menu_dynamic_dashboard_viewer"
              name="Màn hình Dashboard"
              parent="menu_dynamic_dashboard_root"
              action="action_dashboard_viewer_client"
              groups="base.group_user"
              sequence="5"/>

    <!-- Menu Con: Danh sách Dashboard -->
    <menuitem id="menu_dynamic_dashboard_list"
              name="Danh sách Dashboards"
              parent="menu_dynamic_dashboard_root"
              action="action_dynamic_dashboard"
              groups="base.group_user"
              sequence="10"/>

    <!-- Menu Con: Cấu hình Widgets -->
    <menuitem id="menu_dynamic_dashboard_widget_list"
              name="Cấu hình Widgets"
              parent="menu_dynamic_dashboard_root"
              action="action_dynamic_dashboard_widget"
              groups="base.group_user"
              sequence="20"/>

</odoo>
