<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aidt_dashboard_builder.DashboardFilterBar">
        <div class="o_dashboard_filter_bar bg-white border-bottom px-3 px-md-4 py-2.5 d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-3 shadow-2xs">
            <!-- Left Side: Date Range Segmented Pills -->
            <div class="d-flex align-items-center gap-2 overflow-x-auto text-nowrap py-1">
                <div class="d-flex align-items-center text-dark fw-bold small me-1 flex-shrink-0">
                    <i class="fa fa-calendar text-purple me-1.5 fs-6"></i>
                    <span style="color: #0f172a;">Thời gian:</span>
                </div>
                <div class="d-flex align-items-center gap-1 p-1 rounded-pill" style="background-color: #f1f5f9; border: 1px solid #e2e8f0;">
                    <t t-foreach="datePills" t-as="pill" t-key="pill.id">
                        <button t-attf-class="btn btn-sm rounded-pill px-3 py-1 fw-bold transition-all {{state.activePill == pill.id ? 'dash-pill-active shadow-sm' : 'dash-pill-inactive'}}"
                                t-on-click="() => this.selectPill(pill.id)">
                            <t t-esc="pill.label"/>
                        </button>
                    </t>
                </div>
            </div>

            <!-- Right Side: Custom Configured Global Filters Toolbar -->
            <t t-if="props.filters &amp;&amp; props.filters.length > 0">
                <div class="d-flex align-items-center gap-2.5 overflow-x-auto text-nowrap py-1">
                    <div class="d-flex align-items-center text-slate-700 fw-bold small flex-shrink-0 d-none d-sm-flex">
                        <i class="fa fa-sliders me-1.5 text-purple fs-6"></i>
                        <span style="color: #0f172a;">Bộ lọc:</span>
                    </div>

                    <t t-foreach="props.filters" t-as="filter" t-key="filter.id">
                        <div class="dash-filter-chip d-flex align-items-center bg-white rounded-pill px-3 py-1 border shadow-2xs">
                            <span class="small fw-bold me-2 flex-shrink-0 d-flex align-items-center gap-1.5" style="color: #0f172a;">
                                <i class="fa fa-filter text-purple extra-small"></i>
                                <t t-esc="filter.name"/>:
                            </span>
                            <select class="dash-filter-select form-select form-select-sm border bg-white rounded-pill px-2.5 py-0.5 small fw-bold cursor-pointer"
                                    style="min-width: 120px;"
                                    t-on-change="(ev) => this.onCustomFilterChange(filter, ev)">
                                <option value="">-- Tất cả --</option>
                                <t t-foreach="filter.options || []" t-as="opt" t-key="opt.id !== undefined ? opt.id : opt">
                                    <option t-att-value="opt.id !== undefined ? opt.id : opt">
                                        <t t-esc="opt.name !== undefined ? opt.name : opt"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </t>

                    <t t-if="hasActiveFilters">
                        <button class="btn btn-sm rounded-pill px-3 py-1 fw-bold small transition-all d-flex align-items-center gap-1.5 ms-1"
                                style="background-color: #fef2f2; color: #dc2626; border: 1px solid #fca5a5;"
                                t-on-click="resetAllFilters"
                                title="Xóa tất cả bộ lọc">
                            <i class="fa fa-times-circle"></i>
                            <span>Xóa lọc</span>
                        </button>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
