<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aidt_dashboard_builder.ActivityWidget">
        <div t-attf-class="o_dashboard_card activity-card theme-{{props.data ? (props.data.color_theme || 'primary') : 'primary'}} h-100 d-flex flex-column"
             t-attf-style="{{props.data &amp;&amp; props.data.custom_color ? 'border-top: 4px solid ' + props.data.custom_color + ' !important;' : ''}}">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i t-attf-class="fa {{props.data &amp;&amp; props.data.icon ? props.data.icon : 'fa-history'}} text-muted"></i>
                    <h6 class="activity-title mb-0"><t t-esc="props.widget.name"/></h6>
                </div>
                <t t-if="props.widget.drilldown_action_id || (props.data &amp;&amp; props.data.model_name)">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0.5 fs-7 cursor-pointer"
                            t-on-click="onViewDetailsClick" title="Xem tất cả hoạt động">
                        <i class="fa fa-external-link me-1"></i> Xem tất cả
                    </button>
                </t>
                <t t-else="">
                    <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 small">Hoạt động</span>
                </t>
            </div>

            <t t-if="props.data &amp;&amp; props.data.error">
                <div class="widget-error-box my-auto text-center small">
                    <i class="fa fa-exclamation-circle me-1"></i> <t t-esc="props.data.message || 'Lỗi tải hoạt động'"/>
                </div>
            </t>
            <t t-else="">
                <div class="flex-grow-1 overflow-auto">
                    <t t-if="props.data &amp;&amp; props.data.activities &amp;&amp; props.data.activities.length > 0">
                        <div class="d-flex flex-column gap-2">
                            <t t-foreach="props.data.activities" t-as="act" t-key="act.id">
                                <div class="activity-item d-flex align-items-center justify-content-between cursor-pointer"
                                     t-on-click="() => this.onItemClick(act.id)" title="Xem chi tiết bản ghi này">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="activity-avatar">
                                            <t t-esc="act.user ? act.user.substring(0,1).toUpperCase() : 'U'"/>
                                        </div>
                                        <div>
                                            <div class="activity-name"><t t-esc="act.name"/></div>
                                            <div class="activity-meta"><i class="fa fa-user me-1"></i><t t-esc="act.user"/></div>
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fs-7">
                                        <i class="fa fa-clock-o me-1"></i><t t-esc="act.time"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 py-4 text-center text-muted">
                            <i class="fa fa-inbox fs-2 mb-2 text-muted opacity-50"></i>
                            <div class="small fw-semibold">Chưa có hoạt động mới</div>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
