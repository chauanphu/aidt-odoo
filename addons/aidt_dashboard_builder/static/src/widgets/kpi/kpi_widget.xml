<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aidt_dashboard_builder.KpiWidget">
        <div t-attf-class="o_dashboard_card kpi-card cursor-pointer theme-{{props.data ? (props.data.color_theme || 'primary') : 'primary'}}"
             t-attf-style="{{props.data &amp;&amp; props.data.custom_color ? 'border-top: 4px solid ' + props.data.custom_color + ' !important;' : ''}}"
             t-on-click="onClick">
            <div class="kpi-header mb-3 me-1">
                <span class="kpi-title text-truncate me-2" t-att-title="props.widget.name"><t t-esc="props.widget.name"/></span>
                <div class="kpi-icon-wrapper flex-shrink-0">
                    <i t-attf-class="fa {{props.data &amp;&amp; props.data.icon ? props.data.icon : 'fa-tachometer'}}"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="kpi-value"
                     t-attf-style="{{props.data &amp;&amp; props.data.custom_color ? 'color: ' + props.data.custom_color + ' !important;' : ''}}">
                    <t t-esc="props.data ? props.data.formatted_value : '0'"/>
                </div>
                <t t-if="props.widget.drilldown_action_id || (props.data &amp;&amp; props.data.model_name)">
                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fs-7 cursor-pointer" title="Nhấp để xem chi tiết">
                        <i class="fa fa-external-link me-1"></i> Xem
                    </span>
                </t>
            </div>
        </div>
    </t>
</templates>
