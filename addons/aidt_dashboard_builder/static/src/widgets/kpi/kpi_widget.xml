<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aidt_dashboard_builder.KpiWidget">
        <div t-attf-class="o_dashboard_card kpi-card theme-{{props.data ? (props.data.color_theme || 'primary') : 'primary'}}"
             t-attf-style="{{props.data &amp;&amp; props.data.custom_color ? 'border-top: 4px solid ' + props.data.custom_color + ' !important;' : ''}}"
             t-on-click="onClick">
            <div class="kpi-header mb-2">
                <span class="kpi-title fw-semibold text-muted text-uppercase small"><t t-esc="props.widget.name"/></span>
            </div>
            <div class="d-flex align-items-baseline justify-content-between mt-2">
                <div class="kpi-value fw-bold fs-2 text-dark"
                     t-attf-style="{{props.data &amp;&amp; props.data.custom_color ? 'color: ' + props.data.custom_color + ' !important;' : ''}}">
                    <t t-esc="props.data ? props.data.formatted_value : '0'"/>
                </div>
            </div>
        </div>
    </t>
</templates>
